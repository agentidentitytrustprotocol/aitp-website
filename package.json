{
  "name": "aitp-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.x <=22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "check-links": "python3 scripts/check-links.py",
    "check-schemas": "python3 scripts/sync-schemas.py \"${SPEC_DIR:-../agentidentitytrustprotocol}\" --check",
    "check-served-routes": "python3 scripts/check-served-routes.py",
    "test": "vitest run",
    "check-review-dates": "python3 scripts/check-review-dates.py"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/mdx": "^2.0.14",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fumadocs-core": "^16.15.15",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-ui": "^16.15.15",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "fast-xml-parser": "^5.11.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
